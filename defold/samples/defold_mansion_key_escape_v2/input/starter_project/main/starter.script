local dashboard = require("main.dashboard")

local function capture_starter()
	return {
		phase = "not_ready",
		slots = {
			room_index = -1,
			menu_selection_index = -1,
			menu_view_index = -1,
			modal_code = 0,
			journal_read = 0,
			cabinet_checked = 0,
			key_found = 0,
			key_taken = 0,
			has_key = 0,
			door_open = 0,
			shadow_awake = 0,
			danger = 0,
		},
		entities = {},
		targets = {},
	}
end

function init(self)
	msg.post(".", "acquire_input_focus")
	dashboard.init(capture_starter)
	print("MANSION_KEY_ESCAPE_STARTER_READY")
end

function update(self, dt)
	dashboard.update(dt)
end

function on_input(self, action_id, action)
	-- The public starting point intentionally contains no gameplay behavior.
end

function final(self)
	dashboard.final()
end
