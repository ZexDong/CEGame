          }
        },
        { "do": "move_toward", "target": { "kind": "shadow" }, "timeout_s": 20 },
        {
          "do": "wait_until",
          "cond": "phase == lost",
          "timeout_s": 12,
          "check": {
            "id": "MKE_D3_SHADOW_CONTACT_LOSS",
            "source": "gdd:Threat-02",
            "dim": "D3",
            "assert": "phase == lost && slots.room_index == 1 && entity(player).state == caught && entity(shadow).state == caught && slots.shadow_awake == 1"
          }
        },
        {
          "do": "capture",
          "save_as": "FailureFrame",
          "check": {
            "id": "MKE_D5_FAILURE_READABLE",
            "source": "gdd:Threat-02",
            "dim": "D5",
            "assert": "capture_nonblank(FailureFrame) && ocr_contains_any(FailureFrame,[\"GAME OVER\",\"CAUGHT\",\"FAILED\",\"Failure\",\"Caught\"]) && ocr_contains_any(FailureFrame,[\"RESTART\",\"RETRY\",\"ENTER\",\"SHADOW\",\"HOUSE\",\"FOG\",\"Restart\",\"Retry\"])"
          }
        },
        { "do": "snapshot", "save_as": "Lost", "honesty_safe": true },
        { "do": "hold", "key": "right", "seconds": 0.65 },
        {
          "do": "wait_until",
          "cond": "wall_clock_since(Lost) >= 0.35",
          "timeout_s": 1,
          "check": {
            "id": "MKE_D4_FAILURE_TERMINAL_LOCK",
            "source": "gdd:Threat-02",
            "dim": "D4",
            "assert": "phase == lost && entity(player).position == Lost.entity(kind=player).position && slots.room_index == Lost.slots.room_index && slots.key_taken == Lost.slots.key_taken"
          }
        },
        { "do": "press", "key": "confirm_or_interact", "cond": "phase == playing && slots.room_index == 0 && slots.key_taken == 0", "timeout_s": 8 },
        {
          "do": "wait_until",
          "cond": "phase == playing && slots.room_index == 0",
          "timeout_s": 8,
          "check": {
            "id": "MKE_D4_FAILURE_RESTART_CLEAN",
            "source": "gdd:Restart-01",
            "dim": "D4",
            "assert": "phase == playing && slots.room_index == 0 && slots.modal_code == 0 && slots.journal_read == 0 && slots.cabinet_checked == 0 && slots.key_found == 0 && slots.key_taken == 0 && slots.has_key == 0 && slots.door_open == 0 && slots.shadow_awake == 0 && slots.danger == 0 && !exists(kind=key)"
          }
        }
      ]
    },
    {
      "id": "partial_progress_then_reopen",
      "title": "Close and reopen after real puzzle progress, returning to a clean menu",
      "clean_start": "fresh_process",
      "steps": [
        { "do": "start" },
        { "do": "wait_until", "cond": "phase == menu && slots.menu_selection_index == 0", "timeout_s": 15, "honesty_safe": true },
        { "do": "snapshot", "save_as": "HonestyMenuStable" },
        { "do": "press", "key": "confirm_or_interact", "cond": "phase == playing && slots.room_index == 0", "timeout_s": 8 },
        { "do": "wait_until", "cond": "phase == playing && slots.room_index == 0", "timeout_s": 10 },
        { "do": "move_toward", "target": { "kind": "portal", "state": "open" }, "timeout_s": 20 },
        { "do": "wait_until", "cond": "slots.room_index == 1", "timeout_s": 5 },
        { "do": "move_toward", "target": { "kind": "journal" }, "timeout_s": 20 },
        { "do": "press", "key": "confirm_or_interact", "cond": "phase == paused && slots.journal_read == 1", "timeout_s": 5 },
        { "do": "wait_until", "cond": "phase == paused && slots.journal_read == 1", "timeout_s": 5 },
        { "do": "snapshot", "save_as": "Progress", "honesty_safe": true },
        { "do": "reopen" },
        {
          "do": "wait_until",
          "cond": "phase == menu",
          "timeout_s": 15,
          "check": {
            "id": "MKE_D4_REOPEN_CLEAN_MENU",
            "source": "gdd:Lifecycle-01",
            "dim": "D4",
            "assert": "Progress.phase == paused && Progress.slots.journal_read == 1 && phase == menu && slots.room_index < 0 && slots.menu_selection_index == 0 && slots.menu_view_index == 0 && slots.modal_code == 0 && slots.journal_read == 0 && slots.cabinet_checked == 0 && slots.key_found == 0 && slots.key_taken == 0 && slots.has_key == 0 && slots.door_open == 0 && slots.shadow_awake == 0 && slots.danger == 0"
          }
        }
      ]
    }
  ]
}
