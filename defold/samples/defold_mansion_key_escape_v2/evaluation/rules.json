          "do": "capture",
          "save_as": "DoorOpenFrame",
          "check": {
            "id": "MKE_D5_DOOR_OPEN_READABLE",
            "source": "gdd:Door-Lock-04",
            "dim": "D5",
            "assert": "capture_nonblank(DoorOpenFrame) && ocr_contains_any(DoorOpenFrame,[\"OPEN\",\"UNLOCKED\",\"Open\",\"Opened\"]) && ocr_contains_any(DoorOpenFrame,[\"KEY\",\"Key\"]) && slots.door_open == 1 && slots.has_key == 0"
          }
        },
        { "do": "move_toward", "target": { "kind": "exit" }, "timeout_s": 35 },
        {
          "do": "wait_until",
          "cond": "phase == won",
          "timeout_s": 8,
          "check": {
            "id": "MKE_D2_EXIT_SUCCESS_CONTENT",
            "source": "gdd:Exit-01",
            "dim": "D2",
            "assert": "phase == won && slots.room_index == 2 && entity(player).state == escaped && entity(exit).state == reached && entity(exit).visible == true"
          }
        },
        {
          "check": {
            "id": "MKE_D3_EXIT_WIN_BOUNDARY",
            "source": "gdd:Exit-01",
            "dim": "D3",
            "assert": "phase == won && slots.journal_read == 1 && slots.cabinet_checked == 1 && slots.key_taken == 1 && slots.has_key == 0 && slots.door_open == 1"
          }
        },
        {
          "do": "capture",
          "save_as": "SuccessFrame",
          "check": {
            "id": "MKE_D5_SUCCESS_READABLE",
            "source": "gdd:Exit-01",
            "dim": "D5",
            "assert": "capture_nonblank(SuccessFrame) && ocr_contains_any(SuccessFrame,[\"ESCAPED\",\"ESCAPE COMPLETE\",\"SUCCESS\",\"Escape\",\"Success\"]) && ocr_contains_any(SuccessFrame,[\"ENTER\",\"MENU\",\"NEW GAME\",\"DAWN\",\"MANSION\",\"Return\",\"New Game\"])"
          }
        },
        { "do": "snapshot", "save_as": "Won", "honesty_safe": true },
        { "do": "hold", "key": "left", "seconds": 0.65 },
        {
          "do": "wait_until",
          "cond": "wall_clock_since(Won) >= 0.35",
          "timeout_s": 1,
          "check": {
            "id": "MKE_D4_SUCCESS_TERMINAL_LOCK",
            "source": "gdd:Exit-01",
            "dim": "D4",
            "assert": "phase == won && entity(player).position == Won.entity(kind=player).position && slots.room_index == Won.slots.room_index && slots.door_open == Won.slots.door_open"
          }
        },
        { "do": "press", "key": "back", "cond": "phase == menu && slots.menu_selection_index == 0", "timeout_s": 5 },
        { "do": "wait_until", "cond": "phase == menu && slots.menu_selection_index == 0", "timeout_s": 5 },
        { "do": "press", "key": "confirm_or_interact", "cond": "phase == playing && slots.room_index == 0", "timeout_s": 8 },
        { "do": "wait_until", "cond": "phase == playing && slots.room_index == 0", "timeout_s": 8 },
        { "do": "snapshot", "save_as": "FirstNewGame" },
        { "do": "press", "key": "back", "cond": "phase == menu && slots.menu_selection_index == 0", "timeout_s": 5 },
        { "do": "wait_until", "cond": "phase == menu && slots.menu_selection_index == 0", "timeout_s": 5 },
        { "do": "press", "key": "confirm_or_interact", "cond": "phase == playing && slots.room_index == 0", "timeout_s": 8 },
