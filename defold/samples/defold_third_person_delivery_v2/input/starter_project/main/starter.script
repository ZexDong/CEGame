local dashboard = require("main.dashboard")

local function capture_dashboard()
	return {
		phase = "not_ready",
		slots = {
			time_remaining = 0,
			carried_count = 0,
			delivered_count = 0,
			cargo_total = 3,
		},
		entities = {},
		targets = {},
	}
end

function init(self)
	msg.post(".", "acquire_input_focus")
	dashboard.init(capture_dashboard)
	print("THIRD_PERSON_DELIVERY_STARTER_READY")
end

function update(self, dt)
	dashboard.update(dt)
end

function on_input(self, action_id, action)
	-- The public starting point intentionally contains no gameplay behavior.
end

function final(self)
	dashboard.final()
end
