{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checkpoint-script.schema.json",
  "title": "Checkpoint script (Script) — draft v1",
  "type": "object",
  "required": ["schema_version", "game", "naming_tables", "trajectories"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "game": { "type": "string", "minLength": 1 },
    "naming_tables": { "type": "string", "minLength": 1 },
    "player_runtime_min_version": { "type": "string" },
    "controls_from_naming_tables": { "type": "boolean" },
    "honesty_spot_checks": {
      "type": "object",
      "properties": { "per_trajectory": { "type": "integer", "minimum": 0 }, "mode": { "enum": ["random"] } }
    },
    "trajectories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "clean_start", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "title": { "type": "string" },
          "clean_start": { "enum": ["fresh_process", "restart", "none"] },
          "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
        }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object", "required": ["kind"], "additionalProperties": false,
      "properties": { "kind": { "type": "string" }, "state": { "type": "string" } }
    },
    "check": {
      "type": "object", "required": ["id", "source", "dim", "assert"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string", "pattern": "^(gdd:[^\\s]+|common-baseline:CB-[0-9]{2})$" },
        "dim": { "enum": ["D2", "D3", "D4", "D5"] },
        "assert": { "type": "string", "minLength": 1 }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "anyOf": [ { "required": ["do"] }, { "required": ["check"] } ],
      "properties": {
        "do": { "enum": ["start", "click", "press", "hold", "drag", "move_toward", "wait_until", "snapshot", "capture", "restart", "reopen"] },
        "target": { "$ref": "#/$defs/target" },
        "from": { "$ref": "#/$defs/target" },
        "to": { "$ref": "#/$defs/target" },
        "key": { "type": "string" },
        "seconds": { "type": "number", "minimum": 0 },
        "cond": { "type": "string" },
        "timeout_s": { "type": "number", "minimum": 0 },
        "save_as": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "check": { "$ref": "#/$defs/check" }
      }
    }
  }
}
