local dashboard=require "main.dashboard"
local tables=json.decode(sys.load_resource("/benchmark/naming-tables.json"))
local function capture()
    local slots={}
    for _,name in ipairs(tables.slots) do slots[name]=0 end
    slots.client_width,slots.client_height=window.get_size()
    return {phase="not_ready",slots=slots,entities={},targets={}}
end
function init(self)
    msg.post(".","acquire_input_focus")
    local n=gui.new_text_node(vmath.vector3(512,288,0),"PUBLIC STARTER / NOT READY")
    gui.set_font(n,"default")
    dashboard.init(capture)
    print("CAMPAIGN_STARTER_READY")
end
function update(self,dt) dashboard.update(dt) end
function on_input(self,id,action)
    if id==hash("starter_quit") and action.pressed then sys.exit(0) end
end
function final(self) dashboard.final() end
