{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameCreate cross-engine D1-D6 result v2.1 (execution completeness)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "sample_version",
    "evaluator_version",
    "run_id",
    "evaluation_valid",
    "classification",
    "coverage_status",
    "reason",
    "dimensions",
    "checks",
    "coverage_evidence",
    "final_score",
    "max_score"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "2.0",
        "2.1"
      ]
    },
    "sample_id": {
      "$ref": "#/$defs/id"
    },
    "sample_version": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "evaluation_valid": {
      "type": "boolean"
    },
    "classification": {
      "enum": [
        "scored",
        "candidate_failure",
        "incomplete",
        "infrastructure_failure",
        "not_run"
      ]
    },
    "coverage_status": {
      "enum": [
        "not_reviewed",
        "gaps_found",
        "qualified"
      ]
    },
    "reason": {
      "type": "string"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "D1",
        "D2",
        "D3",
        "D4",
        "D5",
        "D6"
      ],
      "properties": {
        "D1": {
          "allOf": [
            {
              "$ref": "#/$defs/dimension"
            },
            {
              "properties": {
                "max_score": {
                  "const": 10
                },
                "score": {
                  "maximum": 10
                }
              }
            }
          ]
        },
        "D2": {
          "allOf": [
            {
              "$ref": "#/$defs/dimension"
            },
            {
              "properties": {
                "max_score": {
                  "const": 30
                },
                "score": {
                  "maximum": 30
                }
              }
            }
          ]
        },
        "D3": {
          "allOf": [
            {
              "$ref": "#/$defs/dimension"
            },
            {
              "properties": {
                "max_score": {
                  "const": 20
                },
                "score": {
                  "maximum": 20
                }
              }
            }
          ]
        },
        "D4": {
          "allOf": [
            {
              "$ref": "#/$defs/dimension"
            },
            {
              "properties": {
                "max_score": {
                  "const": 20
                },
                "score": {
                  "maximum": 20
                }
              }
            }
          ]
        },
        "D5": {
          "allOf": [
            {
              "$ref": "#/$defs/dimension"
            },
            {
              "properties": {
                "max_score": {
                  "const": 10
                },
                "score": {
                  "maximum": 10
                }
              }
            }
          ]
        },
        "D6": {
          "allOf": [
            {
              "$ref": "#/$defs/dimension"
            },
            {
              "properties": {
                "max_score": {
                  "const": 10
                },
                "score": {
                  "maximum": 10
                }
              }
            }
          ]
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "coverage_evidence": {
      "$ref": "#/$defs/evidence"
    },
    "final_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "max_score": {
      "const": 100
    },
    "extensions": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "enum": [
              "scored",
              "candidate_failure"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evaluation_valid": {
            "const": true
          },
          "checks": {
            "minItems": 6
          },
          "dimensions": {
            "additionalProperties": {
              "properties": {
                "status": {
                  "const": "complete"
                }
              }
            }
          },
          "final_score": {
            "type": "number"
          }
        }
      },
      "else": {
        "properties": {
          "evaluation_valid": {
            "const": false
          },
          "final_score": {
            "type": "null"
          },
          "reason": {
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "const": "not_run"
          }
        }
      },
      "then": {
        "properties": {
          "dimensions": {
            "additionalProperties": {
              "properties": {
                "status": {
                  "const": "not_run"
                }
              }
            }
          },
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "not_run"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.0"
          },
          "classification": {
            "enum": [
              "scored",
              "candidate_failure"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "coverage_status": {
            "const": "qualified"
          },
          "coverage_evidence": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/\\\\:]+(?:/[^\\\\:]+)*$"
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "max_score",
        "status",
        "evidence"
      ],
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_score": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "invalid",
            "not_run"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "number"
              },
              "evidence": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement_ids",
        "dimension",
        "max_score",
        "score",
        "status",
        "reason",
        "blocked_by",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "dimension": {
          "enum": [
            "D1",
            "D2",
            "D3",
            "D4",
            "D5",
            "D6"
          ]
        },
        "max_score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 30
        },
        "status": {
          "enum": [
            "pass",
            "partial",
            "fail",
            "blocked_by_candidate",
            "inconclusive_evaluator",
            "not_run"
          ]
        },
        "reason": {
          "type": "string"
        },
        "blocked_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "inconclusive_evaluator",
                  "not_run"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "number"
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "fail",
                  "blocked_by_candidate"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "const": 0
              },
              "reason": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked_by_candidate"
              }
            }
          },
          "then": {
            "properties": {
              "blocked_by": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "blocked_by": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
