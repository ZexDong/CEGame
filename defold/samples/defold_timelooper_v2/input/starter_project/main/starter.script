local dashboard = require("main.dashboard")

local function capture_starter()
	return {
		phase = "not_ready",
		slots = {
			run_serial = 0,
			elapsed_milliseconds = 0,
			next_echo_milliseconds = 0,
			gems_collected = 0,
			gem_total = 0,
			echoes_active = 0,
			player_velocity_x = 0,
			player_velocity_y = 0,
			player_on_ground = 0,
			button_pressed = 0,
			door_open = 0,
			exit_active = 0,
			loss_reason_code = 0,
		},
		entities = {},
		targets = {},
	}
end

function init(self)
	msg.post(".", "acquire_input_focus")
	dashboard.init(capture_starter)
	print("TIMELOOPER_STARTER_READY")
end

function update(self, dt)
	dashboard.update(dt)
end

function on_input(self, action_id, action)
	-- The public starting point intentionally contains no gameplay behavior.
end

function final(self)
	dashboard.final()
end
