{
  "schema_version": 2,
  "game": "defold_timelooper_v2",
  "gdd": "../input/GDD.md",
  "common_baseline": "../input/COMMON_BASELINE.md",
  "checkpoint_script": "rules.json",
  "scoring_compatibility": {
    "source": "defold_timelooper v1 D1-D5 rules",
    "dimension_maxima": {
      "D1": 10,
      "D2": 30,
      "D3": 20,
      "D4": 20,
      "D5": 10
    },
    "checkpoint_counts": {
      "D1": 4,
      "D2": 6,
      "D3": 8,
      "D4": 6,
      "D5": 6
    },
    "rule": "Each unique script check ID is pass/fail. A dimension score is its maximum multiplied by passed checks divided by unique checks in that dimension. Repeated observations are conjunctive evidence, not extra weight. The private core-loop cap is applied only after raw dimension scoring and is reported explicitly."
  },
  "static_checks": [
    {
      "id": "D1-01",
      "title": "Defold project entry, input binding, delivery hygiene, and public Dashboard files are recognizable"
    },
    {
      "id": "D1-02",
      "title": "Bob resolves and builds the project without errors"
    },
    {
      "id": "D1-03",
      "title": "A runnable debug bundle is produced"
    },
    {
      "id": "D1-04",
      "title": "The bundle reaches its menu without player input and emits a conformant Dashboard snapshot"
    }
  ],
  "dynamic_checks": {
    "D2": [
      {
        "id": "D2-01",
        "title": "The running level contains the required multi-height geometry and objects"
      },
      {
        "id": "D2-02",
        "title": "Movement, jumping, pause, restart, and menu input are dynamically available"
      },
      {
        "id": "D2-03",
        "title": "A real history-replaying echo appears during play"
      },
      {
        "id": "D2-04",
        "title": "Five collectible gems and gated exit progression are present"
      },
      {
        "id": "D2-05",
        "title": "The pressure button and controlled collidable door are usable"
      },
      {
        "id": "D2-06",
        "title": "Menu, gameplay, pause, failure, success, retry, and reopen states are reachable"
      }
    ],
    "D3": [
      {
        "id": "D3-01",
        "title": "Tap, hold, release, jump, gravity, and platform landing behave correctly"
      },
      {
        "id": "D3-02",
        "title": "Gems collect once and only all five activate the current-player exit"
      },
      {
        "id": "D3-03",
        "title": "Echo timing, replay progression, and player-collision failure are correct"
      },
      {
        "id": "D3-04",
        "title": "Button occupancy and door collision state stay synchronized"
      },
      {
        "id": "D3-05",
        "title": "Visible spike contact causes terminal failure without phantom collision"
      }
    ],
    "D4": [
      {
        "id": "D4-01",
        "title": "A normal adaptive player journey reaches success through the required echo-door flow"
      },
      {
        "id": "D4-02",
        "title": "Spike and echo failures reach usable result flows"
      },
      {
        "id": "D4-03",
        "title": "Restart and result retry restore every transient gameplay state"
      },
      {
        "id": "D4-04",
        "title": "Pause freezes the world and a newly opened process returns to the menu"
      }
    ],
    "D5": [
      {
        "id": "D5-01",
        "title": "The live main menu is visible and contains readable text",
        "method": "window capture plus narrow OCR"
      },
      {
        "id": "D5-02",
        "title": "The live gameplay HUD and controls are visible and readable",
        "method": "window capture plus narrow OCR and Dashboard cross-check"
      },
      {
        "id": "D5-03",
        "title": "Gem, echo, button, door, and exit feedback matches real state",
        "method": "window captures plus Dashboard cross-check"
      },
      {
        "id": "D5-04",
        "title": "The pause overlay is visible and readable while the background is frozen",
        "method": "window capture plus narrow OCR and Dashboard cross-check"
      },
      {
        "id": "D5-05",
        "title": "Failure and success result interfaces are visible, readable, and operable",
        "method": "window captures plus narrow OCR and Dashboard cross-check"
      }
    ]
  },
