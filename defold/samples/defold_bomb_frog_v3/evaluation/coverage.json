    "rule": "D1 is supplied by the four static checks. For D2-D5, each unique check ID declared by rules.json is one equally weighted pass/fail unit within its dimension. Steps, assertion clauses, OCR tokens, saved snapshots, and repeated evidence rows are not separate points.",
    "score_caps": [
      {
        "id": "two_chamber_progression",
        "max_nonvisual_score": 50,
        "meaning": "Chamber 1 must complete as a non-final frozen stage and Continue must reach the exact carried-state chamber-2 start."
      },
      {
        "id": "armored_and_final_closure",
        "max_nonvisual_score": 70,
        "meaning": "Two settled explosion cycles must expose then kill the armored ghost, and the complete two-chamber campaign must reach and lock final success."
      }
    ]
  },
