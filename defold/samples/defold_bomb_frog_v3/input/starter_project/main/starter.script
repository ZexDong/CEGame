local dashboard = require("main.dashboard")

local function capture_starter()
	return {
		phase = "not_ready",
		slots = {
			run_serial = 0,
			chamber_index = 0,
			chamber_total = 2,
			chamber_width = 0,
			chamber_height = 0,
			stage_clear = 0,
			completed_chambers = 0,
			hearts = 0,
			bombs_remaining = 0,
			active_bomb_count = 0,
			active_explosion_count = 0,
			invulnerability_milliseconds = 0,
			treasures_hidden = 0,
			treasures_revealed = 0,
			treasures_collected = 0,
			treasure_total = 0,
			enemies_alive = 0,
			enemy_total = 0,
			armored_enemies = 0,
			exposed_enemies = 0,
			campaign_treasures_collected = 0,
			campaign_enemies_defeated = 0,
			loss_reason_code = 0,
		},
		entities = {},
		targets = {},
	}
end

function init(self)
	msg.post(".", "acquire_input_focus")
	dashboard.init(capture_starter)
	print("BOMB_FROG_V3_STARTER_READY")
end

function update(self, dt)
	dashboard.update(dt)
end

function on_input(self, action_id, action)
	-- The public starting point intentionally contains no gameplay behavior.
end

function final(self)
	dashboard.final()
end
