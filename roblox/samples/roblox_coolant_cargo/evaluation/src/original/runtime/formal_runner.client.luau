local commandSeq,traceSeq=0,0
local function command(action:string,data:{[string]:any}?) commandSeq+=1; local x=data or {}; x.action=action; x.sequence=commandSeq; print("CCP_COMMAND "..HttpService:JSONEncode(x)) end
local function key(down:boolean,name:string) command(if down then "key_down" else "key_up",{key=name}) end
local function mouseDrag(dx:number,dy:number) command("mouse_drag",{dx=math.round(dx),dy=math.round(dy)}); task.wait(.65) end
local function vec(v:Vector3) return {x=v.X,y=v.Y,z=v.Z} end
local function character() local limit=os.clock()+15 repeat local c=player.Character; local h=c and c:FindFirstChildOfClass("Humanoid"); local r=c and c:FindFirstChild("HumanoidRootPart"); if c and h and r and r:IsA("BasePart") then return c,h,r end task.wait(.05) until os.clock()>limit error("character unavailable") end
local attrs={"CCP_RunId","CCP_CoolantStep","CCP_NextValve","CCP_IntakeOpen","CCP_BypassOpen","CCP_OutletOpen","CCP_CoolantReady","CCP_CellState","CCP_CellCharged","CCP_ChargeProgress","CCP_PowerReady","CCP_ReactorStable","CCP_AirlockStage","CCP_Checkpoint","CCP_DeathCount","CCP_Completed","CCP_RunStart","CCP_FinalTime","CCP_EventSerial","CCP_LastEvent","CCP_FeedbackText"}
local function state() local x={} for _,n in attrs do x[n]=player:GetAttribute(n) end return x end
local function visible(g:GuiObject) local a:Instance?=g while a do if a:IsA("GuiObject") and not a.Visible then return false end if a:IsA("LayerCollector") and not a.Enabled then return false end a=a.Parent end return true end
local function hud() local out={} local root=player:FindFirstChild("PlayerGui") if not root then return out end for _,g in root:GetDescendants() do if g:IsA("TextLabel") then out[g.Parent and g.Parent.Name or g.Name]={text=g.Text,visible=visible(g),x=g.AbsolutePosition.X,y=g.AbsolutePosition.Y,w=g.AbsoluteSize.X,h=g.AbsoluteSize.Y} end end return out end
local function trace(action:string,outcome:string,data:{[string]:any}?) traceSeq+=1; local _,h,r=character(); local x=data or {}; x.trace_id=string.format("ccp-trace-%06d",traceSeq); x.action=action; x.outcome=outcome; x.engine_time=Workspace:GetServerTimeNow(); x.position=vec(r.Position); x.velocity=vec(r.AssemblyLinearVelocity); x.health=h.Health; x.state=state(); print("CCP_TRACE "..HttpService:JSONEncode(x)); return x.trace_id end
local function waitAlive(timeout:number) local deadline=os.clock()+timeout repeat local c=player.Character; local h=c and c:FindFirstChildOfClass("Humanoid"); local r=c and c:FindFirstChild("HumanoidRootPart"); if c and h and r and r:IsA("BasePart") and h.Health>0 then task.wait(.25); if player.Character==c and h.Health>0 then return true,trace("character_ready","alive",{}) end end task.wait(.08) until os.clock()>deadline return false,trace("character_ready","timeout",{}) end
local emitted:{[string]:boolean}={}
local function checkpoint(id:string,status:string,detail:string,ids:{string}?) emitted[id]=true; print("CCP_CHECKPOINT "..HttpService:JSONEncode({checkpoint_id=id,status=status,detail=detail,trace_ids=ids or {},engine_time=Workspace:GetServerTimeNow()})) end
local function release() for _,n in {"W","A","S","D","SPACE","E","R"} do key(false,n) end end
local function horizontal(a:Vector3,b:Vector3) return Vector3.new(a.X-b.X,0,a.Z-b.Z).Magnitude end
local function pulse(target:Vector3,duration:number) local _,h,r=character(); if h.Health<=0 then return end local cam=Workspace.CurrentCamera; if not cam then return end local d=Vector3.new(target.X-r.Position.X,0,target.Z-r.Position.Z); if d.Magnitude<.05 then return end d=d.Unit local f=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z); if f.Magnitude<.05 then f=Vector3.new(0,0,-1) else f=f.Unit end local q=Vector3.new(cam.CFrame.RightVector.X,0,cam.CFrame.RightVector.Z); if q.Magnitude<.05 then q=Vector3.new(1,0,0) else q=q.Unit end local keys={} local fd,rd=d:Dot(f),d:Dot(q) if math.abs(fd)>.15 then table.insert(keys,if fd>0 then "W" else "S") end if math.abs(rd)>.15 then table.insert(keys,if rd>0 then "D" else "A") end for _,n in keys do key(true,n) end task.wait(duration) for _,n in keys do key(false,n) end end
local function drive(target:Vector3,radius:number,timeout:number) local deadline=os.clock()+timeout; local best=math.huge; local improved=os.clock(); local stalls=0 while os.clock()<deadline do local _,h,r=character(); if h.Health<=0 then release(); return false,trace("walk_to","died",{target=vec(target)}) end local d=horizontal(r.Position,target); if d<=radius then release(); return true,trace("walk_to","reached",{target=vec(target),distance=d}) end if d+.25<best then best=d; improved=os.clock() elseif os.clock()-improved>1.5 then stalls+=1; if stalls>5 then release(); return false,trace("walk_to","stalled",{target=vec(target),distance=d}) end local t=Vector3.new(target.X-r.Position.X,0,target.Z-r.Position.Z); if t.Magnitude>.1 then pulse(r.Position+Vector3.new(-t.Z,0,t.X).Unit*(if stalls%2==0 then 7 else -7),.45) end best=d; improved=os.clock() end pulse(target,if d>15 then .22 elseif d>7 then .13 else .07); task.wait(.015) end release(); return false,trace("walk_to","timeout",{target=vec(target)}) end
local function navigate(target:Vector3,radius:number?,timeout:number?) local ids={} local budget=timeout or 24; local started=os.clock(); local _,_,r=character(); local path=PathfindingService:CreatePath({AgentRadius=2,AgentHeight=5,AgentCanJump=false,WaypointSpacing=7}); local ok=pcall(function() path:ComputeAsync(r.Position,target) end) if ok and path.Status==Enum.PathStatus.Success then local ws=path:GetWaypoints(); table.insert(ids,trace("path_compute","success",{target=vec(target),waypoints=#ws})) for i,w in ws do if i>40 then return false,ids end local rem=budget-(os.clock()-started); if rem<=0 then return false,ids end local reached,t=drive(w.Position,3,math.min(6,rem)); table.insert(ids,t); if not reached then return false,ids end end else table.insert(ids,trace("path_compute","unavailable",{target=vec(target),status=path.Status.Name})) end local reached,t=drive(target,radius or 3,budget-(os.clock()-started)); table.insert(ids,t); return reached,ids end
local function taggedOne(tagName:string,id:string?) local found={} for _,x in CollectionService:GetTagged(tagName) do if x:IsA("BasePart") and (id==nil or x:GetAttribute("CCP_Id")==id) then table.insert(found,x) end end assert(#found==1,tagName.." uniqueness failed"); return found[1] end
local function prompt(p:BasePart) local found={} for _,x in p:GetDescendants() do if x:IsA("ProximityPrompt") then table.insert(found,x) end end assert(#found==1,"prompt uniqueness failed for "..p.Name); return found[1] end
local function signedCameraError(target:Vector3) local cam=Workspace.CurrentCamera; if not cam then return 0,-1,false end local _,_,r=character(); local desired=Vector3.new(target.X-r.Position.X,0,target.Z-r.Position.Z); local look=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z); if desired.Magnitude<.1 or look.Magnitude<.1 then return 0,-1,false end desired=desired.Unit; look=look.Unit; local angle=math.atan2(look.X*desired.Z-look.Z*desired.X,look:Dot(desired)); local _,onScreen=cam:WorldToViewportPoint(target); return angle,look:Dot(desired),onScreen end
local function facePrompt(p:BasePart) local ids={} local a0,d0,on0=signedCameraError(p.Position); if d0>.82 and on0 then table.insert(ids,trace("camera_align","already_aligned",{tagged_target=vec(p.Position),dot=d0,on_screen=on0})); return true,ids end mouseDrag(60,0); local a1,d1,on1=signedCameraError(p.Position); local delta=math.atan2(math.sin(a1-a0),math.cos(a1-a0)); if math.abs(delta)<.015 then table.insert(ids,trace("camera_align","no_response",{dot=d1,on_screen=on1})); return false,ids end local pixelsPerRadian=60/delta for _=1,3 do local angle,dot,onScreen=signedCameraError(p.Position); if dot>.82 and onScreen then table.insert(ids,trace("camera_align","aligned",{tagged_target=vec(p.Position),dot=dot,on_screen=onScreen})); return true,ids end mouseDrag(math.clamp(-angle*pixelsPerRadian,-420,420),0) end local _,dot,onScreen=signedCameraError(p.Position); table.insert(ids,trace("camera_align",dot>.82 and onScreen and "aligned" or "not_aligned",{tagged_target=vec(p.Position),dot=dot,on_screen=onScreen})); return dot>.82 and onScreen,ids end
local function promptApproach(p:BasePart,q:ProximityPrompt) local _,_,r=character(); local away=Vector3.zero for _,x in Workspace:GetDescendants() do if x:IsA("ProximityPrompt") and x~=q and x.Enabled then local holder=x.Parent; if holder and holder:IsA("BasePart") then local delta=Vector3.new(p.Position.X-holder.Position.X,0,p.Position.Z-holder.Position.Z); if delta.Magnitude>.1 and delta.Magnitude<q.MaxActivationDistance+x.MaxActivationDistance+20 then away+=delta.Unit/math.max(1,delta.Magnitude) end end end end if away.Magnitude<.01 then away=Vector3.new(r.Position.X-p.Position.X,0,r.Position.Z-p.Position.Z) end if away.Magnitude<.01 then away=Vector3.new(p.CFrame.LookVector.X,0,p.CFrame.LookVector.Z) else away=away.Unit end local localDir=p.CFrame:VectorToObjectSpace(away); local extent=math.abs(localDir.X)*p.Size.X*.5+math.abs(localDir.Z)*p.Size.Z*.5; local offset=math.min(q.MaxActivationDistance*.65,extent+2); return p.Position+away*offset end
local function interact(tagName:string,id:string?) local p=taggedOne(tagName,id); local q=prompt(p); local before=state(); local approachPoint=promptApproach(p,q); local reached,ids=navigate(approachPoint,1.75,25); local _,_,r=character(); local dist=(r.Position-p.Position).Magnitude if not reached and dist>q.MaxActivationDistance then table.insert(ids,trace("establish_prompt","not_reached",{tag=tagName,id=id,distance=dist,approach=vec(approachPoint)})); return false,before,state(),ids end if dist>q.MaxActivationDistance+1 then table.insert(ids,trace("establish_prompt","out_of_range",{tag=tagName,id=id,distance=dist})); return false,before,state(),ids end local competing=0 for _,x in Workspace:GetDescendants() do if x:IsA("ProximityPrompt") and x~=q and x.Enabled then local holder=x.Parent; if holder and holder:IsA("BasePart") and (r.Position-holder.Position).Magnitude<=x.MaxActivationDistance+1 then competing+=1 end end end local facing=true if tagName=="CCP_DeconConsole" then local faceIds; facing,faceIds=facePrompt(p); for _,faceId in faceIds do table.insert(ids,faceId) end; task.wait(.6) end table.insert(ids,trace("establish_prompt",competing==0 and facing and "ready" or "ambiguous",{tag=tagName,id=id,distance=dist,prompt_enabled=q.Enabled,competing_prompts=competing,approach=vec(approachPoint),camera_aligned=tagName=="CCP_DeconConsole" and facing or nil})); if not q.Enabled or competing>0 or not facing then return false,before,state(),ids end key(true,"E"); task.wait(math.max(.15,q.HoldDuration+.15)); key(false,"E"); task.wait(.45); table.insert(ids,trace("prompt_input","sent",{tag=tagName,id=id})); return true,before,state(),ids end
local function walkPart(tagName:string,id:string?,radius:number?,timeout:number?) return navigate(taggedOne(tagName,id).Position,radius or 2,timeout or 20) end
local function waitAttr(name:string,predicate:any,timeout:number) local deadline=os.clock()+timeout repeat local v=player:GetAttribute(name); if predicate(v) then return true,trace("wait_state","matched",{attribute=name,value=v}) end task.wait(.08) until os.clock()>deadline return false,trace("wait_state","timeout",{attribute=name,value=player:GetAttribute(name)}) end
local function pressR() local before=state(); key(true,"R"); task.wait(.15); key(false,"R"); local deadline=os.clock()+3 repeat task.wait(.1) until (player:GetAttribute("CCP_RunId") or 0)>(before.CCP_RunId or 0) or os.clock()>deadline local changed=(player:GetAttribute("CCP_RunId") or 0)>(before.CCP_RunId or 0); local alive,aliveId=waitAlive(12); local after=state(); local id=trace("restart_input",changed and alive and "observed_alive" or "timeout",{run_changed=changed,alive=alive}); return changed and alive,before,after,{id,aliveId} end
