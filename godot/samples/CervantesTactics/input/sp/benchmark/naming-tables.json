    {"kind":"magic_action"}, {"kind":"heal_action"}, {"kind":"limit_action"},
    {"kind":"dialogue_continue_button"},
    {"kind":"confirm_action_button"}, {"kind":"end_turn_button"}, {"kind":"confirmation_button"}, {"kind":"retry_button"},
    {"kind":"main_menu_button"}, {"kind":"options_button"}
  ],
