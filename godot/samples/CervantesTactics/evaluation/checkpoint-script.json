    {
      "id": "entry_and_initial",
      "title": "entry and initial",
      "clean_start": "fresh_process",
      "steps": [
        {
          "do": "start"
        },
        {
          "do": "wait_until",
          "cond": "phase == menu",
          "timeout_s": 30
        },
        {
          "check": {
            "id": "D2-01",
            "source": "gdd:MENU-01",
            "dim": "D2",
            "assert": "The main menu, three save slots, chapter page, options, quit confirmation, and return paths are visible and operable"
          }
        },
        {
          "check": {
            "id": "D3-02",
            "source": "gdd:SAVE-02",
            "dim": "D3",
            "assert": "Three-slot create/overwrite/load/Continue behavior respects commit boundaries, isolation, timing, and empty-slot rules"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "new_game_button"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "save_slot_empty"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "chapter_start_button"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "dialogue_continue_button"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "dialogue_continue_button"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "dialogue_continue_button"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "dialogue_continue_button"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "dialogue_continue_button"
          }
        },
        {
          "do": "wait_until",
          "cond": "phase == playing",
          "timeout_s": 120
        },
        {
          "check": {
            "id": "D2-02",
            "source": "gdd:SCENE-01i",
            "dim": "D2",
            "assert": "The 12x9 isometric battlefield, Crystal, fixed terrain, four Family units, and three enemies are fully present"
          }
        },
        {
          "check": {
            "id": "D3-01",
            "source": "gdd:DATA-01a",
            "dim": "D3",
            "assert": "The board, coordinates, obstacles, traps, Crystal, and every unit match their public initial values"
          }
        },
        {
          "check": {
            "id": "D2-10",
            "source": "gdd:ASSET-01a",
            "dim": "D2",
            "assert": "English UI, specified textures/portraits/scene assets, HUD, layout, and feedback appear in their corresponding screens"
          }
        },
        {
          "do": "capture"
        }
      ]
    },
