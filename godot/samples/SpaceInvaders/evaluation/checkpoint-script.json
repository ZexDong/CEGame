    "mode": "review_against_captured_render_and_input_trace"
  },
  "trajectories": [
    {
      "id": "public_controls",
      "title": "Public controls and dashboard collection",
      "clean_start": "fresh_process",
      "steps": [
        {
          "do": "start"
        },
        {
          "do": "capture"
        },
        {
          "do": "hold",
          "key": "Space",
          "seconds": 3
        },
        {
          "do": "hold",
          "key": "A",
          "seconds": 1
        },
        {
          "do": "hold",
          "key": "D",
          "seconds": 1
        },
        {
          "do": "capture"
        }
      ]
    },
    {
      "id": "entry",
      "title": "Initial shooter state",
      "clean_start": "fresh_process",
      "steps": [
        {
          "do": "start"
        },
        {
          "do": "capture"
        },
        {
          "do": "wait_until",
          "cond": "phase == playing",
          "timeout_s": 15,
          "check": {
            "id": "entry_003",
            "source": "common-baseline:CB-01",
            "dim": "D4",
            "condition": "phase == playing",
            "scoring": "automatic"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.level == 1",
          "timeout_s": 5,
          "check": {
            "id": "entry_002",
            "condition": "slots.level == 1"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.score == 0",
          "timeout_s": 5,
          "check": {
            "id": "entry_001",
            "condition": "slots.score == 0"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.lives == 3",
          "timeout_s": 5,
          "check": {
            "id": "entry_004",
            "condition": "slots.lives == 3"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.invaders_remaining == 40",
          "timeout_s": 5,
          "check": {
            "id": "entry_005",
            "condition": "slots.invaders_remaining == 40"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.player_projectiles == 0",
          "timeout_s": 5,
          "check": {
            "id": "entry_006",
            "condition": "slots.player_projectiles == 0"
          }
        },
        {
          "do": "capture"
        }
      ]
    },
    {
      "id": "core",
      "title": "Movement, fire and pause",
      "clean_start": "fresh_process",
      "steps": [
        {
          "do": "start"
        },
        {
          "do": "capture"
        },
        {
          "do": "wait_until",
          "cond": "phase == playing",
          "timeout_s": 15,
          "check": {
            "id": "core_003",
            "source": "gdd:FORMATION-01",
            "dim": "D3",
            "condition": "slots.invaders_remaining == 40",
            "scoring": "prerequisite"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.enemy_projectiles > 0",
          "timeout_s": 14,
          "check": {
            "id": "core_004",
            "condition": "slots.enemy_projectiles > 0"
          }
        },
        {
          "do": "hold",
          "key": "A",
          "seconds": 0.4,
          "check": {
            "id": "core_001",
            "condition": "entities.player.x < 640"
          }
        },
        {
          "do": "press",
          "key": "W",
          "check": {
            "id": "core_002",
            "source": "gdd:PLAYER-02",
            "dim": "D3",
            "condition": "slots.player_projectiles == 1"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.player_projectiles == 0",
          "timeout_s": 5,
          "check": {
            "id": "core_005",
            "condition": "slots.player_projectiles == 0"
          }
        },
        {
          "do": "wait_until",
          "cond": "entities.invader.count > 0",
          "timeout_s": 5,
          "check": {
            "id": "core_010",
            "condition": "entities.invader.count > 0"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.invaders_remaining > 0",
          "timeout_s": 5,
          "check": {
            "id": "core_011",
            "condition": "slots.invaders_remaining > 0"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.player_projectiles == 0",
          "timeout_s": 5,
          "check": {
            "id": "core_012",
            "condition": "slots.player_projectiles == 0"
          }
        },
        {
          "do": "press",
          "key": "ESCAPE",
          "check": {
            "id": "core_016",
            "source": "gdd:PAUSE-01",
            "dim": "D3",
            "condition": "phase == paused",
            "scoring": "prerequisite"
          },
          "skip_if": "phase != playing"
        },
        {
          "do": "press",
          "key": "ESCAPE",
          "check": {
            "id": "core_017",
            "source": "gdd:PAUSE-02",
            "dim": "D3",
            "condition": "phase == playing",
            "scoring": "prerequisite"
          },
          "skip_if": "phase != paused"
        },
        {
          "do": "press",
          "key": "W",
          "check": {
            "id": "core_018",
            "condition": "slots.player_projectiles == 1"
          }
        },
        {
          "do": "wait_until",
          "cond": "entities.player_projectile.count >= 1",
          "timeout_s": 5,
          "check": {
            "id": "core_019",
            "source": "common-baseline:CB-05",
            "dim": "D5",
            "condition": "entities.player_projectile.count >= 1"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.score > 0",
          "timeout_s": 5,
          "check": {
            "id": "core_021",
            "condition": "slots.score > 0"
          }
        },
        {
          "do": "capture"
        }
      ]
    },
