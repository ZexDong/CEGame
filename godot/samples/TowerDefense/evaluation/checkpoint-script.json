{
  "schema_version": 1,
  "game": "tower_defense",
  "naming_tables": "../input/sp/benchmark/naming-tables.json",
  "controls_from_naming_tables": true,
  "honesty_spot_checks": {
    "mode": "review_against_captured_render_and_input_trace"
  },
  "journey": {
    "trajectory": "waves_attacks_and_success",
    "terminal_step": 34,
    "terminal_slots": {"wave": 10, "wave_total": 10, "remaining_enemies": 0},
    "positive_slot": "base_hp"
  },
  "trajectories": [
    {
      "id": "entry_and_initial",
      "title": "entry and initial",
      "clean_start": "fresh_process",
      "steps": [
        {
          "do": "start"
        },
        {
          "do": "wait_until",
          "cond": "phase == menu",
          "timeout_s": 30
        },
        {
          "check": {
            "id": "D2-01",
            "source": "gdd:ENTRY-01",
            "dim": "D2",
            "assert": "The initial menu, START, Grassland selection, and battlefield entry are complete and operable"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "start_button"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "grassland_button"
          }
        },
        {
          "do": "wait_until",
          "cond": "phase == playing",
          "timeout_s": 30
        },
        {
          "check": {
            "id": "D3-01",
            "source": "gdd:STATE-01",
            "dim": "D3",
            "assert": "Initial 200 Gold, 30/30 base HP, Wave 0/10, countdown, and zero entities are correct"
          }
        },
        {
          "check": {
            "id": "D2-02",
            "source": "gdd:MAP-01",
            "dim": "D2",
            "assert": "The Grassland map, continuous grass, stone road, and route relationships are clearly visible"
          }
        },
        {
          "check": {
            "id": "D5-ENTRY",
            "source": "common-baseline:CB-07",
            "dim": "D5",
            "assert": "START, Grassland, tower cards, and the main HUD are visible, readable, and inside the window"
          }
        },
        {
          "check": {
            "id": "D5-HUD",
            "source": "gdd:HUD-01",
            "dim": "D5",
            "assert": "Gold, base HP, Wave, countdown, and Remaining are synchronized with the dashboard"
          }
        },
        {
          "do": "capture"
        }
      ]
    },
    {
      "id": "building_and_management",
      "title": "building and management",
      "clean_start": "fresh_process",
      "steps": [
        {
          "do": "start"
        },
        {
          "do": "wait_until",
          "cond": "phase == menu",
          "timeout_s": 30
        },
        {
          "do": "click",
          "target": {
            "kind": "start_button"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "grassland_button"
          }
        },
        {
          "do": "wait_until",
          "cond": "phase == playing",
          "timeout_s": 30
        },
        {
          "do": "drag",
          "from": {
            "kind": "tower_card",
            "state": "explosive"
          },
          "to": {
            "kind": "build_surface",
            "state": "open_grass_1"
          }
        },
        {
          "check": {
            "id": "D2-03",
            "source": "gdd:BUILD-01",
            "dim": "D2",
            "assert": "All four tower cards support free dragging, legal preview/building, and complete invalid-drop feedback"
          }
        },
        {
          "check": {
            "id": "D3-03",
            "source": "gdd:BUILD-02",
            "dim": "D3",
            "assert": "Building on continuous grass works; road/obstacle/overlap/bounds/funds rejections never deduct resources incorrectly"
          }
        },
        {
          "check": {
            "id": "D2-04",
            "source": "gdd:TOWER-01",
            "dim": "D2",
            "assert": "Gatling, Flamethrower, Raygun, and Explosive roles, assets, and attack presentations are distinguishable"
          }
        },
        {
          "check": {
            "id": "D3-04",
            "source": "gdd:TOWER_HP-01",
            "dim": "D3",
            "assert": "Maximum tower HP at each level, damage, upgrade ratios, repair, and destruction/refund rules are correct"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "tower",
            "state": "selected"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.wave >= 1",
          "timeout_s": 60
        },
        {
          "do": "wait_until",
          "cond": "slots.remaining_enemies <= 4",
          "timeout_s": 60
        },
        {
          "do": "click",
          "target": {
            "kind": "repair_button"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "upgrade_button"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "sell_button"
          }
        },
        {
          "check": {
            "id": "D2-07",
            "source": "gdd:MANAGE-01",
            "dim": "D2",
            "assert": "Tower details, upgrades, sale, level cap, and economy feedback are complete"
          }
        },
        {
          "check": {
            "id": "D2-08",
            "source": "gdd:REPAIR-01",
            "dim": "D2",
            "assert": "Tower health bars, HP text, Repair - 20 Gold, and repair feedback are complete"
          }
        },
        {
          "check": {
            "id": "D3-05",
            "source": "gdd:ECON-01",
            "dim": "D3",
            "assert": "Gold accounting for purchases, kills, upgrades, sales, and repairs is correct"
          }
        },
        {
          "check": {
            "id": "D5-BUILD",
            "source": "gdd:FEEDBACK-01",
            "dim": "D5",
            "assert": "Drag preview, rejection, building, selection, upgrade, sale, and repair feedback are clear and consistent"
          }
        },
        {
          "do": "capture"
        }
      ]
    },
