            "id": "core_026",
            "condition": "slots.queue_length == 0"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "produce_worker"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "produce_worker"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "produce_worker"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "produce_worker"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "produce_worker"
          }
        },
