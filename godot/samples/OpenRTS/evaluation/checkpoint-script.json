          "check": {
            "id": "core_022",
            "condition": "slots.selected_hp == 110"
          }
        },
        {
          "do": "press",
          "key": "ESCAPE",
          "check": {
            "id": "core_027",
            "condition": "phase == paused"
          }
        },
        {
          "do": "press",
          "key": "ESCAPE"
