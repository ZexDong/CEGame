    {
      "id": "public_controls",
      "title": "Public controls and dashboard collection",
      "clean_start": "fresh_process",
      "steps": [
        {
          "do": "start"
        },
        {
          "do": "capture"
        },
        {
          "do": "click",
          "target": {
            "kind": "quick_play"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "build_command_center"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "battlefield"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "produce_worker"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "resource_target"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "build_vehicle_factory"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "battlefield"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "produce_tank"
          }
        },
        {
          "do": "capture"
        }
      ]
    },
    {
      "id": "entry",
      "title": "Quick play and initial match state",
      "clean_start": "fresh_process",
      "steps": [
        {
          "do": "start"
        },
        {
          "do": "capture"
        },
        {
          "do": "wait_until",
          "cond": "phase == menu",
          "timeout_s": 15,
          "check": {
            "id": "entry_004",
            "source": "common-baseline:CB-01",
            "dim": "D4",
            "condition": "phase == menu",
            "scoring": "automatic"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "quick_play"
          }
        },
        {
          "do": "wait_until",
          "cond": "phase == playing",
          "timeout_s": 15,
          "check": {
            "id": "entry_002",
            "condition": "phase == playing"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.unit_count == 3",
          "timeout_s": 5,
          "check": {
            "id": "entry_003",
            "condition": "slots.unit_count == 3"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.friendly_command_centers == 1",
          "timeout_s": 5,
          "check": {
            "id": "entry_001",
            "condition": "slots.friendly_command_centers == 1"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.resource_a == 10",
          "timeout_s": 5,
          "check": {
            "id": "entry_005",
            "condition": "slots.resource_a == 10"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.resource_b == 10",
          "timeout_s": 5,
          "check": {
            "id": "entry_006",
            "condition": "slots.resource_b == 10"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.idle_workers == 2",
          "timeout_s": 5,
          "check": {
            "id": "entry_007",
            "condition": "slots.idle_workers == 2"
          }
        },
        {
          "do": "capture"
        }
      ]
    },
    {
