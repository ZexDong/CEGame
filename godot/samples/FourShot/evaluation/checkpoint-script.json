          "do": "click",
          "target": {
            "kind": "level_2_button"
          }
        },
        {
          "do": "capture",
          "save_as": "lifecycle_transition_2"
        },
        {
          "do": "click",
          "target": {
            "kind": "start_button"
          }
        },
        {
          "do": "capture",
          "save_as": "lifecycle_transition_3"
        },
        {
          "do": "hold",
          "key": "D",
          "seconds": 0.25
        },
        {
          "do": "snapshot",
          "save_as": "BeforeClose"
        },
        {
          "do": "reopen"
        },
        {
          "do": "capture",
          "save_as": "lifecycle_transition_6"
        },
        {
          "do": "wait_until",
          "cond": "phase == menu",
          "timeout_s": 30
        },
        {
          "check": {
            "id": "D3-01",
            "source": "gdd:ENTRY-05a",
            "dim": "D3",
            "assert": "Public initial states, level exceptions, object uniqueness, and cross-level isolation match the public values"
          }
        },
        {
          "check": {
            "id": "D4-05",
            "source": "common-baseline:CB-03",
            "dim": "D4",
            "assert": "The exact old PID ends; the new PID returns to the menu without restoring gameplay state"
          }
        },
        {
          "check": {
            "id": "D2-10",
            "source": "gdd:ASSET-01a",
            "dim": "D2",
            "assert": "HUD, feedback, results, and declared images, fonts, and audio are used in the corresponding runtime states"
          }
        },
        {
          "do": "wait_until",
          "cond": "phase == menu",
          "timeout_s": 10
        },
        {
          "do": "capture"
        }
      ]
    }
  ]
}
