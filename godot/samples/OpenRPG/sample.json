{
  "schema_version": "2.0",
  "release_status": "packaged",
  "sample_id": "OpenRPG",
  "sample_version": "1.0.0",
  "benchmark_id": "godot.openrpg_forest_reconstruction.v2",
  "title": "Open RPG - Forest Reconstruction",
  "engine": {
    "name": "Godot"
  },
  "environment": {
    "runtime": "GDScript",
    "setup_commands": [],
    "credential_environment_variables": []
  },
  "sources": [
    {
      "url": null,
      "repository": null,
      "revision": null,
      "license": "MIT",
      "adaptation_scope": "Retained forest reconstruction scope (five-line opening, Gobot movement, forest terrain/collision, camera) from the MIT-licensed GDQuest Open RPG."
    }
  ],
  "input": {
    "path": "input/",
    "prompt": "input/INITIAL_AGENT_PROMPT-en.md",
    "design": "input/GDD-en.md",
    "tools": "input/GODOT_BENCHMARK_TOOL_GUIDE.md",
    "assets": "input/Assets/",
    "starter_project": "input/sp/",
    "contracts": "input/DASHBOARD_SPEC.md",
    "self_check": "input/sp/benchmark/public_smoke.gd"
  },
  "submission": {
    "type": "complete_project",
    "entry_scene": "res://src/main.tscn",
    "viewport": [
      1920,
      1080
    ]
  },
  "evaluation": {
    "version": "godot-public-2",
    "entry": "evaluation/evaluate.py",
    "command": [
      "python",
      "evaluation/evaluate.py",
      "--project",
      "{project}",
      "--output",
      "{output}"
    ],
    "rules": "evaluation/rules.json",
    "coverage": "evaluation/coverage.json",
    "result_schema": "evaluation/score.schema.json",
    "result_file": "score.json",
    "max_score": 100,
    "notes": "Engine collection with evidence-backed requirement review.",
    "native_entry": "evaluation/src/runtime.py",
    "result_format_version": "2.1"
  }
}
