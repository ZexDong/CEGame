          "do": "start"
        },
        {
          "do": "capture"
        },
        {
          "do": "wait_until",
          "cond": "phase == menu",
          "timeout_s": 15,
          "check": {
            "id": "entry_011",
            "source": "common-baseline:CB-01",
            "dim": "D4",
            "condition": "phase == menu",
            "scoring": "automatic"
          }
        },
        {
          "do": "wait_until",
          "cond": "slots.profile_cash == 0",
          "timeout_s": 5,
