        {
          "do": "wait_until",
          "cond": "phase == menu",
          "timeout_s": 5
        },
        {
          "do": "click",
          "target": {
            "kind": "play_button"
          }
        },
        {
          "do": "wait_until",
          "cond": "phase == playing",
          "timeout_s": 15,
          "check": {
            "id": "entry_002",
            "source": "gdd:ENTRY-02",
            "dim": "D2",
            "condition": "phase == playing",
