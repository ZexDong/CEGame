{
  "schema_version": 1,
  "game": "motaro_drive_procedural_reconstruction",
  "naming_tables": "../input/sp/benchmark/naming-tables.json",
  "controls_from_naming_tables": true,
  "honesty_spot_checks": {
    "mode": "review_against_captured_render_and_input_trace"
  },
  "trajectories": [
    {
      "id": "public_controls",
      "title": "Public controls and dashboard collection",
      "clean_start": "fresh_process",
      "steps": [
        {
          "do": "start"
        },
        {
          "do": "capture"
        },
        {
          "do": "click",
          "target": {
            "kind": "play_button"
          }
        },
        {
          "do": "click",
          "target": {
            "kind": "level_button"
          }
        },
        {
          "do": "hold",
          "key": "D",
          "seconds": 2
        },
        {
          "do": "press",
          "key": "Space"
        },
        {
          "do": "hold",
          "key": "A",
          "seconds": 1
        },
        {
          "do": "capture"
        }
      ]
    },
    {
