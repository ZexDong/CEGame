{
  "schema": "stormbound-natural-entry-review-shape/v1",
  "review_schema": "stormbound-natural-entry-review/v1",
  "required_fields": [
    "schema",
    "decision",
    "reviewer",
    "reason",
    "candidate_source_sha256",
    "player_receipt_sha256",
    "after_png_sha256",
    "before_png_sha256",
    "process_id"
  ],
  "decisions": [
    "initial_gameplay_visible",
    "menu_or_ambiguous",
