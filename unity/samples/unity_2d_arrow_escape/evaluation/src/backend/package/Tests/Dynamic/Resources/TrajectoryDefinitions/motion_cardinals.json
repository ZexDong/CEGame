{
  "schema_version": 1,
  "id": "motion_cardinals",
  "title": "Virtual Mouse exits arrows continuously in all four cardinal directions",
  "steps": [
    {
      "step_id": "setup.scene",
      "operation": "load_canonical_scene",
      "target": "scene:ArrowEscape",
      "check_ids": [
        "setup.scene_load",
        "setup.probe",
        "setup.playable"
      ]
    },
    {
      "step_id": "declared.scoring_checks",
      "operation": "observe_visible_player_journeys",
      "target": "running_scene",
