{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "dimensions",
    "functional_total",
    "overall",
    "checkpoints",
    "diagnostic_only",
    "formal_freeze_performed"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "status": {
      "const": "diagnostic_completed"
    },
    "diagnostic_only": {
      "const": true
    },
    "formal_freeze_performed": {
      "const": false
    },
    "functional_total": {
      "type": "number",
      "minimum": 0,
      "maximum": 90
    },
    "overall": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "dimensions": {
      "type": "object",
      "required": [
        "D1",
        "D2",
        "D3",
        "D4",
        "D5",
        "D6"
      ],
      "additionalProperties": false,
      "properties": {
        "D1": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "D2": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "D3": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "D4": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "D5": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "D6": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "required": [
          "checkpoint_id",
          "dimension",
          "verdict",
          "reason",
          "evidence"
        ],
        "properties": {
          "checkpoint_id": {
            "type": "string",
            "pattern": "^D[1-5]-[0-9]{2}$"
          },
          "dimension": {
            "enum": [
              "D1",
              "D2",
              "D3",
              "D4",
              "D5"
            ]
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "unreachable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
