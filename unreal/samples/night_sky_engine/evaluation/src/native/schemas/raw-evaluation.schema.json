{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "candidate_id",
    "candidate_identity_sha256",
    "catalog_sha256",
    "input_gdd_sha256",
    "status",
    "checkpoints",
    "captures",
    "faults",
    "budget",
    "evaluator_identity",
    "evidence_sha256",
    "scoring_contract_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "status": {
      "enum": [
        "completed",
        "invalid"
      ]
    },
    "checkpoints": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "required": [
          "checkpoint_id",
          "dimension",
          "verdict",
          "reason",
          "evidence"
        ],
        "properties": {
          "checkpoint_id": {
            "type": "string",
            "pattern": "^D[1-5]-[0-9]{2}$"
          },
          "dimension": {
            "enum": [
              "D1",
              "D2",
              "D3",
              "D4",
              "D5"
            ]
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "unreachable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "captures": {
      "type": "object"
    },
    "faults": {
      "type": "array"
    },
    "budget": {
      "type": "object"
    },
    "evaluator_identity": {
      "type": "object"
    },
    "evidence_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
