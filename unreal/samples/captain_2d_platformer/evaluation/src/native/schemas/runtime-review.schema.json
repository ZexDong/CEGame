{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Completed fixed runtime picture review",
  "type": "object",
  "required": [
    "schema_version",
    "method",
    "reviewer",
    "raw_sha256",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "method": {
      "const": "fixed_human_runtime_review"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "passed",
          "reason",
          "evidence"
        ],
        "properties": {
          "passed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  }
}
