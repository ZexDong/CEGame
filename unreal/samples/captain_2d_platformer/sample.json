{
  "schema_version": "2.0",
  "release_status": "packaged",
  "sample_id": "captain_2d_platformer",
  "sample_version": "2.0.0",
  "title": "Captain's Key Run",
  "category": "Platformer / action",
  "engine": {
    "name": "Unreal Engine",
    "origin": "Unreal-native; no source-engine port"
  },
  "environment": {
    "runtime": "UnrealEditor -game",
    "setup_commands": [
      [
        "python",
        "-m",
        "pip",
        "install",
        "-r",
        "evaluation/requirements.txt"
      ]
    ],
    "external_dependencies": [
      "Licensed installation of Unreal Engine and the required C++ build toolchain.",
      "Interactive desktop for real input and capture.",
      "External visual review/API access as specified by the frozen D6 protocol; charges depend on provider."
    ],
    "credential_environment_variables": [
      "D6_API_KEY",
      "OPENAI_API_KEY"
    ],
    "private_endpoint_included": false
  },
  "sources": [
    {
      "url": "https://github.com/HenriqueCacerez/captain2D-platformer-UE5",
      "revision": "32ab3fdadbbe8f47923d46b602447bf553c33788",
      "revision_status": "fixed",
      "license": "NOASSERTION",
      "adaptation_scope": "Existing answer-free starter, bounded task assets, public requirements and native evaluator; complete upstream, Gold and submitted games excluded."
    }
  ],
  "input": {
    "path": "input",
    "export_command": [
      "python",
      "-B",
      "input/self-check/check_package.py",
      "--export-input",
      "{new_directory}"
    ],
    "prompt": "input/INITIAL_AGENT_PROMPT.md",
    "design": "input/GDD.md",
    "tools": "input/tools/TOOL_GUIDE.md",
    "assets": "input/assets/ASSET_CATALOG.json",
    "starter_project": "input/starter-project",
    "contracts": "input/contracts",
    "self_check": "input/self-check/check_package.py"
  },
  "submission": {
    "type": "complete_project",
    "accepted_paths": [
      "Returned input directory",
      "Unreal project directory",
      "Unreal .uproject file"
    ]
  },
  "evaluation": {
    "version": "2.0.0",
    "native_game": "Captain2DPlatformer",
    "command": [
      "python",
      "evaluation/evaluate.py",
      "--project",
      "{project}",
      "--output",
      "{output}",
      "--engine",
      "{engine}"
    ],
    "rules": "evaluation/rules.json",
    "coverage": "evaluation/coverage.json",
    "result_schema": "evaluation/score.schema.json",
    "result_file": "score.json",
    "max_score": 100,
    "native_layout": "src/native",
    "native_catalog": "scoring-catalog.json",
    "checks": 44,
    "gdd_requirement_rows": 30,
    "gdd_sub_obligations": 185,
    "entry": "evaluation/evaluate.py",
    "result_format_version": "2.1"
  },
  "compatibility": {
    "input_revision": "Template layout v2; exact frozen input bytes can be reconstructed using evaluation/src/input-layout.json for existing scoring bindings.",
    "public_session": "Read-only observation interface.",
    "d6": "Use the task-specific fixed states and round aggregation in evaluation/d6."
  }
