{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-result.schema.json",
  "title": "Bomber Local Duel complete diagnostic evaluation result",
  "type": "object",
  "required": [
    "schema_version", "game_id", "task_name", "task_revision", "engine", "run_id", "candidate_id",
    "candidate_identity_sha256", "evaluator_revision", "scorer_revision", "evaluation_status",
    "diagnostic_only", "formal_freeze_performed", "dimensions", "functional_total", "overall",
    "executable", "solved", "checkpoints", "candidate_failures", "faults", "budget"
  ],
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "game_id": { "const": "Bomber" },
    "task_name": { "const": "Bomber Local Duel" },
    "task_revision": { "const": "2.0.1" },
    "engine": { "const": "Unreal Engine 5.7.4" },
    "run_id": { "type": "string" },
    "candidate_id": { "type": "string" },
    "candidate_identity_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evaluator_revision": { "const": "bomber-evaluator-5.0.0" },
    "scorer_revision": { "const": "bomber-canonical-scorer-5.0.0" },
    "evaluation_status": { "const": "completed" },
    "diagnostic_only": { "const": true },
    "formal_freeze_performed": { "const": false },
    "dimensions": {
      "type": "object",
      "required": ["D1", "D2", "D3", "D4", "D5", "D6"],
      "properties": {
        "D1": { "$ref": "#/$defs/dimension" },
        "D2": { "$ref": "#/$defs/dimension" },
        "D3": { "$ref": "#/$defs/dimension" },
        "D4": { "$ref": "#/$defs/dimension" },
        "D5": { "$ref": "#/$defs/dimension" },
        "D6": { "type": "object", "required": ["score", "maximum", "round_scores", "status", "model_id"] }
      }
    },
    "functional_total": { "type": "number", "minimum": 0, "maximum": 90 },
    "overall": { "type": "number", "minimum": 0, "maximum": 100 },
    "executable": { "enum": ["Yes", "No"] },
    "solved": { "enum": ["Yes", "No"] },
    "checkpoints": { "type": "array" },
    "candidate_failures": { "type": "array" },
    "faults": { "type": "array", "maxItems": 0 },
    "budget": { "type": "object" }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["score", "maximum", "passed", "failed", "unreachable", "total"],
      "properties": {
        "score": { "type": "number" },
        "maximum": { "type": "number" },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "unreachable": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
