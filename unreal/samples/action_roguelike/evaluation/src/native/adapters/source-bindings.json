        "TELEPORT_WRITE": "P->bTeleportAcquired = Flag;",
        "TELEPORT_READ": "P->bTeleportAcquired",
        "CLOCK_WRITE": "G->SurvivalTime = 60.0 - Number;",
        "CLOCK_READ": "60.0 - (G->SurvivalTime)",
        "CONTEXT": "// Remove only records for physics props already destroyed by the engine setup.\n        const TArray<TSharedPtr<FJsonValue>>* RemovedProps;\n        if (Request->TryGetArrayField(TEXT(\"remove_props\"), RemovedProps))\n        {\n            int32 RemovedCount = 0;\n            for (const auto& Value : *RemovedProps)\n            {\n                const auto Position = Value->AsObject();\n                const FVector Where(Position->GetNumberField(TEXT(\"x\")) * 100.0,\n                                    Position->GetNumberField(TEXT(\"y\")) * 100.0,\n                                    Position->GetNumberField(TEXT(\"z\")) * 100.0);\n                int32 Match = INDEX_NONE;\n                for (int32 Index = 0; Index < G->Objects.Num(); ++Index)\n                {\n                    auto* Prop = Cast<AArenaPhysicsProp>(G->Objects[Index].Get());\n                    if (!Prop || !Prop->IsActorBeingDestroyed() ||\n                        FVector::Dist(Prop->GetActorLocation(), Where) > 10.0) continue;\n                    if (Match != INDEX_NONE) return false;\n                    Match = Index;\n                }\n                if (Match == INDEX_NONE) return false;\n                G->Objects.RemoveAt(Match);\n                ++RemovedCount;\n            }\n            Receipt->SetNumberField(TEXT(\"removed_prop_records\"), RemovedCount);\n            Receipt->SetBoolField(TEXT(\"prop_storage_verified\"), RemovedCount == RemovedProps->Num());\n        }"
      },
