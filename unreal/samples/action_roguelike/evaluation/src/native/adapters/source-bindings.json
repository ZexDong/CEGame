      "cpp": {
        "PLAYER": "ARiftPawn",
        "GAMEMODE": "AArenaGameMode",
        "HEALTH_WRITE": "P->Health = Number;",
        "HEALTH_READ": "P->Health",
        "CREDITS_WRITE": "G->Credits = Number;",
