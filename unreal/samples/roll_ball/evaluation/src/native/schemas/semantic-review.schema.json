{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "status",
    "collection_sha256",
    "checks"
  ],
  "properties": {
    "version": {
      "const": "4.0.0"
    },
    "status": {
      "enum": [
        "draft",
        "completed"
      ]
    },
    "checks": {
      "type": "object"
    }
  }
}
