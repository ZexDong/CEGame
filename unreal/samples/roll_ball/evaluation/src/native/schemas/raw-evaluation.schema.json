{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "cases",
    "faults"
  ],
  "properties": {
    "version": {
      "const": "4.0.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1
    },
    "faults": {
      "type": "array"
    }
  }
}
